{
    "name": "@excel-preview/core",
    "version": "0.1.4",
    "description": "Core engine for Excel preview and chart rendering (framework-agnostic)",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zhanghongyi1/excel-viewer.git"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean --external exceljs --external echarts",
        "watch": "tsup src/index.ts --format esm,cjs --dts --watch --external exceljs --external echarts",
        "dev": "pnpm watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:update": "vitest run -u"
    },
    "dependencies": {
        "echarts": "^5.4.3",
        "exceljs": "^4.4.0",
        "fast-xml-parser": "^4.3.4",
        "hyperformula": "^3.3.0",
        "jszip": "^3.10.1"
    },
    "devDependencies": {
        "tsup": "^8.0.2",
        "typescript": "^5.3.3",
        "vitest": "^4.1.10"
    }
}
